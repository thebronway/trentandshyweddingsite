---
import Layout from '../components/Layout.astro';

const error = Astro.url.searchParams.get('error');
const redirectTo = Astro.url.searchParams.get('redirectTo') || '/about';
---
<Layout title="Presale Access">
  <main class="min-h-[100dvh] flex items-center justify-center p-6">
    <div class="max-w-5xl w-full flex flex-col md:flex-row bg-zinc-800/60 backdrop-blur-md border border-zinc-700 shadow-2xl overflow-hidden rounded-sm">
      
      <div class="md:w-1/2 md:aspect-[4/5] bg-transparent relative flex flex-col md:block md:p-8 border-b md:border-b-0 md:border-r border-zinc-700">
         <img src="/images/presale.webp" alt="Trent and Shy" class="relative md:absolute inset-0 w-full h-[400px] md:h-full object-cover object-top md:object-center" />
         
         <div class="relative z-10 w-full bg-zinc-950/70 p-6 sm:p-8 md:rounded-sm backdrop-blur-sm border-t md:border border-zinc-800/50">
           <h2 class="text-4xl md:text-6xl text-white font-display tracking-widest uppercase mb-2">Trent & Shy</h2>
           <p class="text-pink-400 font-bold uppercase tracking-wider text-sm mb-4">The "Till Death" Tour • One Night Only</p>
           
           <div class="space-y-1 border-l-2 border-pink-400 pl-4">
             <p class="text-zinc-300 uppercase tracking-widest text-xs font-bold">Oct 10, 2026</p>
             <p class="text-zinc-400 uppercase tracking-widest text-xs">Baltimore, MD</p>
           </div>
         </div>
      </div>

      <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center bg-zinc-900/60">
        <div class="mb-8">
          <h1 class="text-3xl md:text-4xl text-pink-400 font-display tracking-widest uppercase mb-2">Unlock Site Access</h1>
          <p class="text-zinc-200 font-bold tracking-widest uppercase text-sm leading-relaxed">Enter the Passcode (12 Characters) below the QR code on the RSVP insert to unlock the site</p>
        </div>

        {error === 'invalid' && (
          <div class="bg-red-950/50 border border-red-900 text-red-500 px-4 py-3 mb-6 text-xs font-bold uppercase tracking-widest text-center">
            Invalid Presale Code
          </div>
        )}

        {error === 'rsvpcode' && (
          <div class="bg-amber-950/50 border border-amber-900 text-amber-500 px-4 py-3 mb-6 text-xs font-bold uppercase tracking-widest text-center leading-relaxed">
            Hey, it looks like you used your RSVP code to try to log onto the site. <br /><br />Instead, please enter the 12 character passcode located below the QR code on your invitation to log onto the site.
          </div>
        )}

        <div id="rsvp-warning" class="hidden bg-amber-950/50 border border-amber-900 text-amber-500 px-4 py-3 mb-6 text-xs font-bold uppercase tracking-widest text-center leading-relaxed">
          Hey! It looks like you're entering your 4-digit RSVP code. <br /><br /> Instead, please enter the 12-character website passcode (below the QR Code) here.
        </div>

        <form action="/api/verify" method="POST" class="flex flex-col gap-4">
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <input 
            type="text" 
            id="passcode-input"
            name="code"
            required 
            placeholder="SITE PASSCODE"
            oninput="this.value = this.value.toUpperCase().replace(/ /g, '')"
            class="w-full bg-zinc-900 border border-zinc-700 text-zinc-100 px-4 py-4 text-lg text-center tracking-widest uppercase focus:outline-none focus:border-pink-400 focus:ring-1 focus:ring-pink-400 transition-colors rounded-sm"
          />
          <button type="submit" class="w-full bg-zinc-200 hover:bg-white text-zinc-900 font-bold text-lg uppercase tracking-widest py-4 transition-colors rounded-sm">
            Unlock Site
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  (() => {
    const input = document.getElementById('passcode-input');
    const warning = document.getElementById('rsvp-warning');
    
    if (input && warning) {
      input.addEventListener('input', (e) => {
        const val = e.target.value;
        // Show warning if exactly 4 numbers are entered
        if (val.length === 4 && /^\d{4}$/.test(val)) {
          warning.classList.remove('hidden');
        } else {
          warning.classList.add('hidden');
        }
      });
    }
  })();
</script>
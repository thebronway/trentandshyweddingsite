---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import { db } from '../../db';
import { faqs } from '../../db/schema';
import { asc } from 'drizzle-orm';

const allFaqs = await db.select().from(faqs).orderBy(asc(faqs.sortOrder));
---
<Layout title="Manage FAQs">
  <Nav />
  <main class="max-w-4xl mx-auto p-6 w-full mt-8">
    <div class="flex justify-between items-end border-b border-zinc-700 pb-4 mb-6">
      <h1 class="text-4xl text-white font-display uppercase tracking-widest">Manage FAQs</h1>
      <a href="/admin" class="text-pink-400 text-xs font-bold uppercase tracking-widest">&larr; Back to Control</a>
    </div>

    <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.0.8/dist/trix.css">
    <script type="text/javascript" src="https://unpkg.com/trix@2.0.8/dist/trix.umd.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js" is:inline></script>

    <div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 rounded-sm p-6 shadow-2xl mb-8 border-l-4 border-l-pink-400">
      <h2 class="text-xl font-display text-zinc-100 uppercase tracking-widest mb-4">Add New FAQ</h2>
      <form action="/api/admin/faqs" method="POST" class="space-y-4">
        <input type="hidden" name="action" value="add" />
        <div>
          <label class="block text-xs font-bold uppercase text-zinc-500 mb-1">Question</label>
          <input type="text" name="question" required class="w-full bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-100 px-3 py-2 focus:outline-none focus:border-pink-400 focus:ring-1 focus:ring-pink-400 transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-zinc-500 mb-1">Answer (Rich Text)</label>
          <input id="answer-input" type="hidden" name="answer">
          <trix-editor input="answer-input" class="bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-100 min-h-[150px] focus:outline-none focus:border-pink-400 focus:ring-1 focus:ring-pink-400 transition-colors"></trix-editor>
        </div>
        <button type="submit" class="bg-zinc-200 hover:bg-white text-zinc-900 font-bold uppercase px-8 py-2 rounded-sm transition-colors">Save FAQ</button>
      </form>
    </div>

    <div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 rounded-sm p-6 shadow-2xl">
      <h2 class="text-xl font-display text-zinc-100 uppercase tracking-widest mb-4">Current FAQs (Drag to Sort)</h2>
      <ul id="faq-list" class="space-y-4">
        {allFaqs.map((faq) => (
          <li data-id={faq.id} class="bg-zinc-900/60 border border-zinc-700 rounded-sm p-4 flex flex-col cursor-move hover:border-pink-400 transition-colors">
            <div class="flex justify-between items-start mb-2">
              <strong class="text-zinc-100 text-lg uppercase tracking-wider">{faq.question}</strong>
              <div class="flex items-center gap-4">
                <button type="button" class="trigger-edit-faq text-pink-400 hover:text-pink-300 font-bold uppercase tracking-widest text-xs" data-id={faq.id} data-question={faq.question} data-answer={faq.answer}>
                  Edit
                </button>
                <form action="/api/admin/faqs" method="POST" onsubmit="return confirm('Delete this FAQ?');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={faq.id} />
                  <button type="submit" class="text-red-600 font-bold px-2 hover:text-red-400">X</button>
                </form>
              </div>
            </div>
            <div class="text-sm text-zinc-400 prose prose-invert max-w-none" set:html={faq.answer}></div>
          </li>
        ))}
      </ul>
      <button id="save-order-btn" class="mt-6 bg-zinc-200 hover:bg-white text-zinc-900 font-bold uppercase px-8 py-2 w-full hidden rounded-sm transition-colors">Save New Order</button>
    </div>

    <div id="edit-faq-modal" class="hidden fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4">
      <div class="bg-zinc-800/90 backdrop-blur-xl border border-zinc-700 p-6 shadow-2xl border-l-4 border-l-pink-400 w-full max-w-2xl rounded-sm">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-display text-zinc-100 uppercase tracking-widest">Edit FAQ</h2>
          <button type="button" class="close-edit-faq text-zinc-500 hover:text-zinc-300 font-bold">X</button>
        </div>
        <form action="/api/admin/faqs" method="POST" class="space-y-4">
          <input type="hidden" name="action" value="edit" />
          <input type="hidden" name="id" id="edit-faq-id" />
          <div>
            <label class="block text-xs font-bold uppercase text-zinc-500 mb-1">Question</label>
            <input type="text" name="question" id="edit-faq-question" required class="w-full bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-100 px-3 py-2 focus:outline-none focus:border-pink-400 focus:ring-1 focus:ring-pink-400 transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-zinc-500 mb-1">Answer (Rich Text)</label>
            <input id="edit-faq-answer-input" type="hidden" name="answer">
            <trix-editor id="edit-faq-trix" input="edit-faq-answer-input" class="bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-100 min-h-[150px] focus:outline-none focus:border-pink-400 focus:ring-1 focus:ring-pink-400 transition-colors"></trix-editor>
          </div>
          <div class="flex justify-end gap-4 mt-4 border-t border-zinc-800 pt-4">
            <button type="button" class="close-edit-faq bg-zinc-700 hover:bg-zinc-600 text-zinc-200 font-bold uppercase px-6 py-2 rounded-sm transition-colors">Cancel</button>
            <button type="submit" class="bg-zinc-200 hover:bg-white text-zinc-900 font-bold uppercase px-8 py-2 rounded-sm transition-colors">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
;(() => {
  const el = document.getElementById('faq-list');
  const saveBtn = document.getElementById('save-order-btn');
  
  if (el) {
    Sortable.create(el, {
      animation: 150,
      onEnd: function () {
        saveBtn.classList.remove('hidden');
      },
    });

    saveBtn.addEventListener('click', async () => {
      const items = [...el.children].map(li => li.getAttribute('data-id'));
      await fetch('/api/admin/faqs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reorder', order: items })
      });
      window.location.reload();
    });
  }

  // Edit FAQ Modal Logic
  document.querySelectorAll('.trigger-edit-faq').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget;
      document.getElementById('edit-faq-id').value = el.getAttribute('data-id') || '';
      document.getElementById('edit-faq-question').value = el.getAttribute('data-question') || '';
      
      const answer = el.getAttribute('data-answer') || '';
      document.getElementById('edit-faq-answer-input').value = answer;
      document.getElementById('edit-faq-trix').editor.loadHTML(answer);
      
      document.getElementById('edit-faq-modal').classList.remove('hidden');
    });
  });

  document.querySelectorAll('.close-edit-faq').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('edit-faq-modal').classList.add('hidden');
    });
  });

})();
</script>
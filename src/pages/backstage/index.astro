---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import { db } from '../../db';
import { guests } from '../../db/schema';

const formatTime = (date: Date | null) => {
  if (!date) return '';
  return new Date(date).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
};

const allGuests = await db.select().from(guests);

// Calculate Initial Stats Server-Side
let expectedTotal = 0;
let checkedInTotal = 0;

allGuests.forEach(g => {
  if (g.hasRsvpd && g.isAttending) {
    expectedTotal++;
    if (g.isCheckedIn) checkedInTotal++;
  }
  if (g.allocatedPlusOnes >= 1 && g.p1Attending === 'true') {
    expectedTotal++;
    if (g.p1CheckedIn) checkedInTotal++;
  }
  if (g.allocatedPlusOnes >= 2 && g.p2Attending === 'true') {
    expectedTotal++;
    if (g.p2CheckedIn) checkedInTotal++;
  }
  if (g.allocatedPlusOnes >= 3 && g.p3Attending === 'true') {
    expectedTotal++;
    if (g.p3CheckedIn) checkedInTotal++;
  }
});

// Flatten guests for the Individual View
const allIndividuals: any[] = [];
allGuests.forEach(g => {
  allIndividuals.push({ id: g.id, target: 'main', firstName: g.firstName, lastName: g.lastName, role: g.role, isExpected: g.hasRsvpd && g.isAttending, hasRsvpd: g.hasRsvpd, rsvpStatus: g.isAttending, isCheckedIn: g.isCheckedIn, checkInTime: g.checkInTime, partyCode: g.partyCode, dietaryNotes: g.dietaryNotes });
  if (g.allocatedPlusOnes >= 1 && g.p1Name) allIndividuals.push({ id: g.id, target: 'p1', firstName: g.p1Name, lastName: g.p1LastName, role: g.p1Role, isExpected: g.p1Attending === 'true', hasRsvpd: g.p1Attending !== 'pending', rsvpStatus: g.p1Attending, isCheckedIn: g.p1CheckedIn, checkInTime: g.p1CheckInTime, partyCode: g.partyCode, dietaryNotes: g.dietaryNotes });
  if (g.allocatedPlusOnes >= 2 && g.p2Name) allIndividuals.push({ id: g.id, target: 'p2', firstName: g.p2Name, lastName: g.p2LastName, role: g.p2Role, isExpected: g.p2Attending === 'true', hasRsvpd: g.p2Attending !== 'pending', rsvpStatus: g.p2Attending, isCheckedIn: g.p2CheckedIn, checkInTime: g.p2CheckInTime, partyCode: g.partyCode, dietaryNotes: g.dietaryNotes });
  if (g.allocatedPlusOnes >= 3 && g.p3Name) allIndividuals.push({ id: g.id, target: 'p3', firstName: g.p3Name, lastName: g.p3LastName, role: g.p3Role, isExpected: g.p3Attending === 'true', hasRsvpd: g.p3Attending !== 'pending', rsvpStatus: g.p3Attending, isCheckedIn: g.p3CheckedIn, checkInTime: g.p3CheckInTime, partyCode: g.partyCode, dietaryNotes: g.dietaryNotes });
});
---
<Layout title="Guest Check-In">
  <Nav />
  <main class="max-w-5xl mx-auto p-4 sm:p-6 w-full mt-8">
    
    <div class="flex flex-col sm:flex-row justify-between items-end border-b border-zinc-700 pb-4 mb-6">
      <div>
        <h1 class="text-4xl md:text-5xl text-zinc-100 font-display mb-1 uppercase">Door Check-In</h1>
        <p class="text-zinc-500 uppercase tracking-widest text-xs font-bold">Backstage Access Only</p>
      </div>
      <div class="flex gap-4 mt-4 sm:mt-0 text-right">
        <div class="bg-zinc-900/80 border border-zinc-700 p-3 rounded-sm min-w-[100px]">
          <div class="text-3xl font-display text-emerald-400 leading-none" id="checked-in-counter">{checkedInTotal}</div>
          <div class="text-[9px] uppercase tracking-widest text-zinc-500 mt-1">Checked In</div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-700 p-3 rounded-sm min-w-[100px]">
          <div class="text-3xl font-display text-zinc-300 leading-none" id="remaining-counter">{expectedTotal - checkedInTotal}</div>
          <div class="text-[9px] uppercase tracking-widest text-zinc-500 mt-1">Remaining</div>
        </div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row gap-4 mb-4">
      <div class="flex-1 flex gap-4">
        <select id="view-toggle" class="bg-zinc-900 border border-zinc-700 text-zinc-300 font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm flex-1 cursor-pointer appearance-none">
            <option value="party">Party View</option>
            <option value="individual">Individual View</option>
        </select>
        <select id="sort-toggle" class="bg-zinc-900 border border-zinc-700 text-zinc-300 font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm flex-1 cursor-pointer appearance-none">
            <option value="lastName">Sort: Last Name</option>
            <option value="firstName">Sort: First Name</option>
        </select>
      </div>
      <button id="print-export-btn" class="bg-zinc-200 hover:bg-white text-zinc-900 font-bold uppercase tracking-widest text-xs px-8 py-3 rounded-sm transition-colors md:w-auto w-full">
          Export / Print
      </button>
    </div>

    <div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 p-4 shadow-xl rounded-sm mb-6 flex flex-col gap-4">
      <input type="text" id="guest-search" placeholder="Search..." class="w-full bg-zinc-900 border border-zinc-700 text-zinc-100 px-4 py-3 focus:outline-none focus:border-pink-400 uppercase text-sm tracking-widest rounded-sm" />
      
      <div class="flex flex-col xl:flex-row gap-4 justify-between items-start xl:items-center border-t border-zinc-700 pt-4">
        
        <div class="flex flex-wrap gap-2 w-full xl:w-auto">
          <button class="filter-btn active bg-pink-600 text-white font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-filter="all">All</button>
          <button class="filter-btn bg-zinc-900 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-filter="expected">Expected</button>
          <button class="filter-btn bg-zinc-900 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-filter="checked-in">Checked In</button>
          <button class="filter-btn bg-zinc-900 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-filter="needs-approval">Issues / Pending</button>
          <button class="filter-btn bg-zinc-900 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-filter="vip-list">VIP List</button>
        </div>

        <div class="flex flex-wrap gap-2 w-full xl:w-auto xl:border-l xl:border-zinc-700 xl:pl-4">
          <button class="status-filter-btn active bg-emerald-600 border border-emerald-500/50 text-white font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-status="attending" data-active-class="bg-emerald-600 border-emerald-500/50 text-white">Hell Yes</button>
          <button class="status-filter-btn active bg-red-600 border border-red-500/50 text-white font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-status="declined" data-active-class="bg-red-600 border-red-500/50 text-white">Declined</button>
          <button class="status-filter-btn active bg-zinc-500 border border-zinc-400 text-white font-bold uppercase tracking-widest text-xs px-4 py-3 rounded-sm transition-colors" data-status="pending" data-active-class="bg-zinc-500 border-zinc-400 text-white">Pending</button>
        </div>

      </div>
    </div>

    <div id="views-wrapper">  
      <div class="view-container grid grid-cols-1 md:grid-cols-2 gap-4" id="view-party">
      {allGuests.sort((a, b) => a.lastName?.localeCompare(b.lastName || '') || 0).map(guest => {
        const renderRoleBadge = (roleStr: string | null | undefined) => {
          const r = (roleStr || 'guest').toLowerCase();
          if (r === 'admin') return <span class="bg-amber-500/20 text-amber-400 border border-amber-500/50 px-2 py-1 rounded-sm text-xs font-bold tracking-widest uppercase whitespace-nowrap">Main Act</span>;
          if (r === 'openers') return <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/50 px-2 py-1 rounded-sm text-xs font-bold tracking-widest uppercase whitespace-nowrap">Openers</span>;
          if (r === 'vip') return <span class="bg-purple-500/20 text-purple-400 border border-purple-500/50 px-2 py-1 rounded-sm text-xs font-bold tracking-widest uppercase whitespace-nowrap">★ VIP ★</span>;
          return <span class="bg-zinc-700/50 text-zinc-400 border border-zinc-600 px-2 py-1 rounded-sm text-xs font-bold tracking-widest uppercase whitespace-nowrap">Guest</span>;
        };

        // Determine Party Expectations
        const mainExpected = guest.hasRsvpd && guest.isAttending;
        const p1Expected = guest.allocatedPlusOnes >= 1 && guest.p1Attending === 'true';
        const p2Expected = guest.allocatedPlusOnes >= 2 && guest.p2Attending === 'true';
        const p3Expected = guest.allocatedPlusOnes >= 3 && guest.p3Attending === 'true';
        
        const anyExpected = mainExpected || p1Expected || p2Expected || p3Expected;
        const totalInParty = (mainExpected ? 1 : 0) + (p1Expected ? 1 : 0) + (p2Expected ? 1 : 0) + (p3Expected ? 1 : 0);
        
        const getStatusStr = (hasRsvpd: boolean, isAttending: any) => {
          if (!hasRsvpd || isAttending === 'pending') return 'pending';
          if (isAttending === 'true' || isAttending === true || isAttending === 'attending') return 'attending';
          return 'declined';
        };
        const partyStatuses = [
          getStatusStr(guest.hasRsvpd, guest.isAttending)
        ];
        if (guest.allocatedPlusOnes >= 1 && guest.p1Name) partyStatuses.push(getStatusStr(guest.p1Attending !== 'pending', guest.p1Attending));
        if (guest.allocatedPlusOnes >= 2 && guest.p2Name) partyStatuses.push(getStatusStr(guest.p2Attending !== 'pending', guest.p2Attending));
        if (guest.allocatedPlusOnes >= 3 && guest.p3Name) partyStatuses.push(getStatusStr(guest.p3Attending !== 'pending', guest.p3Attending));
        const uniquePartyStatuses = Array.from(new Set(partyStatuses)).join(',');

        const filterClass = anyExpected ? 'guest-card-expected' : 'guest-card-needs-approval';
        const searchString = `${guest.firstName} ${guest.lastName || ''} ${guest.p1Name || ''} ${guest.p2Name || ''} ${guest.p3Name || ''} ${guest.partyCode || ''} ${guest.email || ''} ${guest.phoneNumber || ''} ${guest.p1Email || 
''} ${guest.p1PhoneNumber || ''} ${guest.p2Email || ''} ${guest.p2PhoneNumber || ''} ${guest.p3Email || ''} ${guest.p3PhoneNumber || ''}`.toLowerCase();
return (
          <div class={`guest-card ${filterClass} bg-zinc-800/60 backdrop-blur-md border ${anyExpected ? 'border-zinc-700' : 'border-red-900/50 bg-red-950/20'} p-5 shadow-xl rounded-sm flex flex-col`} data-search={searchString} data-role={guest.role} data-last-name={(guest.lastName || '').toLowerCase()} data-first-name={(guest.firstName || '').toLowerCase()} data-statuses={uniquePartyStatuses}>
            
            <div class="flex justify-between items-start mb-4">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="text-xl font-display text-white uppercase tracking-wider leading-none">{guest.lastName ? `${guest.lastName}, ` : ''}{guest.firstName} Party</h3>
                </div>
                {guest.partyCode && <p class="text-zinc-500 text-xs font-mono tracking-widest uppercase">CODE: {guest.partyCode}</p>}
              </div>
            </div>

            {guest.dietaryNotes && (
              <div class="mb-4 bg-amber-950/50 border border-amber-500/50 text-amber-300 p-2 text-xs uppercase tracking-wider font-bold rounded-sm flex items-center gap-2">
                <span>⚠️ Allergies:</span> {guest.dietaryNotes}
              </div>
            )}

            <div class="flex-1 space-y-2 mb-4">
              {/* Main Guest */}
              <div class={`party-member-row flex justify-between items-center p-2 rounded-sm border ${mainExpected ? 'border-zinc-700 bg-zinc-900/50' : 'border-red-900/30 bg-red-950/30 opacity-50'}`} data-guest-status={getStatusStr(guest.hasRsvpd, guest.isAttending)}>
                <div class="flex flex-col">
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-zinc-200 uppercase font-bold tracking-widest">{guest.firstName} {guest.lastName || ''}</span>
                    {renderRoleBadge(guest.role)}
                  </div>
                  {!mainExpected && <span class="text-[9px] text-red-400 font-bold uppercase tracking-widest">{guest.hasRsvpd ? 'Declined' : 'Pending'}</span>}
                  {mainExpected && <span class="checkin-time text-[10px] text-zinc-400 font-bold uppercase tracking-widest">{guest.isCheckedIn ? formatTime(guest.checkInTime) : ''}</span>}
                </div>
                {mainExpected ? (
                  <button class="checkin-toggle text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-sm transition-colors data-[status=true]:bg-emerald-600 data-[status=true]:text-white data-[status=false]:bg-zinc-700 data-[status=false]:text-zinc-300 hover:opacity-80" data-id={guest.id} data-target="main" data-status={guest.isCheckedIn ? 'true' : 'false'}>
                    {guest.isCheckedIn ? 'Undo' : 'Check In'}
                  </button>
                ) : (
                  <div class="override-container w-full sm:w-auto mt-2 sm:mt-0">
                    <button class="trigger-override w-full text-[10px] text-zinc-400 font-bold uppercase tracking-widest px-3 py-2 border border-zinc-700 bg-zinc-900/50 hover:bg-zinc-800 rounded-sm transition-colors">
                      Walk-Up Override
                    </button>
                    <div class="override-form hidden flex flex-col gap-1 w-[160px]">
                       <p class="text-[8px] text-pink-400 uppercase tracking-widest text-center leading-tight mb-1">Ask Officiant, Trent, or Shy for Code</p>
                       <div class="flex gap-1">
                         <button class="cancel-override bg-zinc-800 text-zinc-500 hover:text-red-400 hover:bg-red-950/50 font-bold px-2 py-1 rounded-sm text-xs transition-colors" type="button">X</button>
                         <input type="text" class="override-pw flex-1 w-full bg-zinc-950 border border-zinc-700 text-zinc-100 px-2 py-1 text-xs text-center uppercase tracking-widest rounded-sm focus:outline-none focus:border-pink-400" placeholder="CODE" />
                         <button class="submit-override bg-zinc-200 text-zinc-900 font-bold px-3 py-1 rounded-sm text-xs hover:bg-white transition-colors" data-id={guest.id} data-target="main">➔</button>
                       </div>
                    </div>
                  </div>
                )}
              </div>

              {/* Plus Ones */}
              {guest.allocatedPlusOnes >= 1 && (
                 <div class={`party-member-row flex justify-between items-center p-2 rounded-sm border ${p1Expected ? 'border-zinc-700 bg-zinc-900/50' : 'border-red-900/30 bg-red-950/30 opacity-50'}`} data-guest-status={getStatusStr(guest.p1Attending !== 'pending', guest.p1Attending)}>
                  <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                      <span class="text-sm text-zinc-300 uppercase font-bold tracking-widest">{guest.p1Name ? `${guest.p1Name} ${guest.p1LastName || ''} (Guest)` : 'Guest'}</span>
                      {renderRoleBadge(guest.p1Role)}
                    </div>
                    {!p1Expected && <span class="text-[9px] text-red-400 font-bold uppercase tracking-widest">{guest.p1Attending === 'false' ? 'Declined' : 'Pending'}</span>}
                    {p1Expected && <span class="checkin-time text-[10px] text-zinc-400 font-bold uppercase tracking-widest">{guest.p1CheckedIn ? formatTime(guest.p1CheckInTime) : ''}</span>}
                  </div>
                  {p1Expected ? (
                    <button class="checkin-toggle text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-sm transition-colors data-[status=true]:bg-emerald-600 data-[status=true]:text-white data-[status=false]:bg-zinc-700 data-[status=false]:text-zinc-300 hover:opacity-80" data-id={guest.id} data-target="p1" data-status={guest.p1CheckedIn ? 'true' : 'false'}>
                      {guest.p1CheckedIn ? 'Undo' : 'Check In'}
                    </button>
                  ) : (
                    <div class="override-container w-full sm:w-auto mt-2 sm:mt-0">
                    <button class="trigger-override w-full text-[10px] text-zinc-400 font-bold uppercase tracking-widest px-3 py-2 border border-zinc-700 bg-zinc-900/50 hover:bg-zinc-800 rounded-sm transition-colors">
                      Walk-Up Override
                    </button>
                    <div class="override-form hidden flex flex-col gap-1 w-[160px]">
                       <p class="text-[8px] text-pink-400 uppercase tracking-widest text-center leading-tight mb-1">Ask Officiant, Trent, or Shy for Code</p>
                       <div class="flex gap-1">
                         <button class="cancel-override bg-zinc-800 text-zinc-500 hover:text-red-400 hover:bg-red-950/50 font-bold px-2 py-1 rounded-sm text-xs transition-colors" type="button">X</button>
                         <input type="text" class="override-pw flex-1 w-full bg-zinc-950 border border-zinc-700 text-zinc-100 px-2 py-1 text-xs text-center uppercase tracking-widest rounded-sm focus:outline-none focus:border-pink-400" placeholder="CODE" />
                         <button class="submit-override bg-zinc-200 text-zinc-900 font-bold px-3 py-1 rounded-sm text-xs hover:bg-white transition-colors" data-id={guest.id} data-target="p1">➔</button>
                       </div>
                    </div>
                  </div>
                  )}
                </div>
              )}
              {guest.allocatedPlusOnes >= 2 && (
                 <div class={`party-member-row flex justify-between items-center p-2 rounded-sm border ${p2Expected ? 'border-zinc-700 bg-zinc-900/50' : 'border-red-900/30 bg-red-950/30 opacity-50'}`} data-guest-status={getStatusStr(guest.p2Attending !== 'pending', guest.p2Attending)}>
                  <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                      <span class="text-sm text-zinc-300 uppercase font-bold tracking-widest">{guest.p2Name ? `${guest.p2Name} ${guest.p2LastName || ''} (Guest)` : 'Guest'}</span>
                      {renderRoleBadge(guest.p2Role)}
                    </div>
                    {!p2Expected && <span class="text-[9px] text-red-400 font-bold uppercase tracking-widest">{guest.p2Attending === 'false' ? 'Declined' : 'Pending'}</span>}
                    {p2Expected && <span class="checkin-time text-[10px] text-zinc-400 font-bold uppercase tracking-widest">{guest.p2CheckedIn ? formatTime(guest.p2CheckInTime) : ''}</span>}
                  </div>
                  {p2Expected ? (
                    <button class="checkin-toggle text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-sm transition-colors data-[status=true]:bg-emerald-600 data-[status=true]:text-white data-[status=false]:bg-zinc-700 data-[status=false]:text-zinc-300 hover:opacity-80" data-id={guest.id} data-target="p2" data-status={guest.p2CheckedIn ? 'true' : 'false'}>
                      {guest.p2CheckedIn ? 'Undo' : 'Check In'}
                    </button>
                  ) : (
                    <div class="override-container w-full sm:w-auto mt-2 sm:mt-0">
                    <button class="trigger-override w-full text-[10px] text-zinc-400 font-bold uppercase tracking-widest px-3 py-2 border border-zinc-700 bg-zinc-900/50 hover:bg-zinc-800 rounded-sm transition-colors">
                      Walk-Up Override
                    </button>
                    <div class="override-form hidden flex flex-col gap-1 w-[160px]">
                       <p class="text-[8px] text-pink-400 uppercase tracking-widest text-center leading-tight mb-1">Ask Officiant, Trent, or Shy for Code</p>
                       <div class="flex gap-1">
                         <button class="cancel-override bg-zinc-800 text-zinc-500 hover:text-red-400 hover:bg-red-950/50 font-bold px-2 py-1 rounded-sm text-xs transition-colors" type="button">X</button>
                         <input type="text" class="override-pw flex-1 w-full bg-zinc-950 border border-zinc-700 text-zinc-100 px-2 py-1 text-xs text-center uppercase tracking-widest rounded-sm focus:outline-none focus:border-pink-400" placeholder="CODE" />
                         <button class="submit-override bg-zinc-200 text-zinc-900 font-bold px-3 py-1 rounded-sm text-xs hover:bg-white transition-colors" data-id={guest.id} data-target="p2">➔</button>
                       </div>
                    </div>
                  </div>
                  )}
                </div>
              )}
              {guest.allocatedPlusOnes >= 3 && (
                 <div class={`party-member-row flex justify-between items-center p-2 rounded-sm border ${p3Expected ? 'border-zinc-700 bg-zinc-900/50' : 'border-red-900/30 bg-red-950/30 opacity-50'}`} data-guest-status={getStatusStr(guest.p3Attending !== 'pending', guest.p3Attending)}>
                  <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                      <span class="text-sm text-zinc-300 uppercase font-bold tracking-widest">{guest.p3Name ? `${guest.p3Name} ${guest.p3LastName || ''} (Guest)` : 'Guest'}</span>
                      {renderRoleBadge(guest.p3Role)}
                    </div>
                    {!p3Expected && <span class="text-[9px] text-red-400 font-bold uppercase tracking-widest">{guest.p3Attending === 'false' ? 'Declined' : 'Pending'}</span>}
                    {p3Expected && <span class="checkin-time text-[10px] text-zinc-400 font-bold uppercase tracking-widest">{guest.p3CheckedIn ? formatTime(guest.p3CheckInTime) : ''}</span>}
                  </div>
                  {p3Expected ? (
                    <button class="checkin-toggle text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-sm transition-colors data-[status=true]:bg-emerald-600 data-[status=true]:text-white data-[status=false]:bg-zinc-700 data-[status=false]:text-zinc-300 hover:opacity-80" data-id={guest.id} data-target="p3" data-status={guest.p3CheckedIn ? 'true' : 'false'}>
                      {guest.p3CheckedIn ? 'Undo' : 'Check In'}
                    </button>
                  ) : (
                    <div class="override-container w-full sm:w-auto mt-2 sm:mt-0">
                    <button class="trigger-override w-full text-[10px] text-zinc-400 font-bold uppercase tracking-widest px-3 py-2 border border-zinc-700 bg-zinc-900/50 hover:bg-zinc-800 rounded-sm transition-colors">
                      Walk-Up Override
                    </button>
                    <div class="override-form hidden flex flex-col gap-1 w-[160px]">
                       <p class="text-[8px] text-pink-400 uppercase tracking-widest text-center leading-tight mb-1">Ask Officiant, Trent, or Shy for Code</p>
                       <div class="flex gap-1">
                         <button class="cancel-override bg-zinc-800 text-zinc-500 hover:text-red-400 hover:bg-red-950/50 font-bold px-2 py-1 rounded-sm text-xs transition-colors" type="button">X</button>
                         <input type="text" class="override-pw flex-1 w-full bg-zinc-950 border border-zinc-700 text-zinc-100 px-2 py-1 text-xs text-center uppercase tracking-widest rounded-sm focus:outline-none focus:border-pink-400" placeholder="CODE" />
                         <button class="submit-override bg-zinc-200 text-zinc-900 font-bold px-3 py-1 rounded-sm text-xs hover:bg-white transition-colors" data-id={guest.id} data-target="p3">➔</button>
                       </div>
                    </div>
                  </div>
                  )}
                </div>
              )}
            </div>

            {totalInParty > 1 && anyExpected && (
              <button class="check-in-all-btn w-full bg-zinc-200 hover:bg-white text-zinc-900 font-bold uppercase tracking-widest py-2 rounded-sm text-xs mt-auto transition-colors">
                Check In Entire Party ({totalInParty})
              </button>
            )}
          </div>
        )
      })}
      </div>

      <div class="view-container grid grid-cols-1 md:grid-cols-3 gap-4 hidden" id="view-individual">
        {allIndividuals.sort((a, b) => a.lastName?.localeCompare(b.lastName || '') || 0).map(ind => {
          const filterClass = ind.isExpected ? 'guest-card-expected' : 'guest-card-needs-approval';
          const searchString = `${ind.firstName} ${ind.lastName || ''} ${ind.partyCode || ''}`.toLowerCase();
          const indStatus = (!ind.hasRsvpd || ind.rsvpStatus === 'pending') ? 'pending' : (ind.rsvpStatus === 'true' || ind.rsvpStatus === true || ind.rsvpStatus === 'attending' ? 'attending' : 'declined');
          
          return (
            <div class={`guest-card ${filterClass} bg-zinc-800/60 backdrop-blur-md border ${ind.isExpected ? 'border-zinc-700' : 'border-red-900/50 bg-red-950/20'} p-4 shadow-xl rounded-sm flex flex-col`} data-search={searchString} data-role={ind.role} data-last-name={(ind.lastName || '').toLowerCase()} data-first-name={(ind.firstName || '').toLowerCase()} data-statuses={indStatus}>
              
              <div class="flex justify-between items-start mb-4">
                <div class="flex flex-col">
                  <h3 class="text-lg font-display text-white uppercase tracking-wider leading-none mb-1">{ind.firstName} {ind.lastName || ''}</h3>
                  <div class="flex gap-2">
                    {ind.role === 'admin' ? <span class="bg-amber-500/20 text-amber-400 border border-amber-500/50 px-1.5 py-0.5 rounded-sm text-[9px] font-bold tracking-widest uppercase whitespace-nowrap">Main Act</span> : null}
                    {ind.role === 'openers' ? <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/50 px-1.5 py-0.5 rounded-sm text-[9px] font-bold tracking-widest uppercase whitespace-nowrap">Openers</span> : null}
                    {ind.role === 'vip' ? <span class="bg-purple-500/20 text-purple-400 border border-purple-500/50 px-1.5 py-0.5 rounded-sm text-[9px] font-bold tracking-widest uppercase whitespace-nowrap">★ VIP ★</span> : null}
                    {ind.partyCode && <span class="text-zinc-500 text-[9px] font-mono tracking-widest uppercase px-1.5 py-0.5 border border-zinc-700 rounded-sm">CODE: {ind.partyCode}</span>}
                  </div>
                </div>
              </div>

              {!ind.isExpected && <span class="text-xs text-red-400 font-bold uppercase tracking-widest mb-2 block">{ind.hasRsvpd ? 'Declined' : 'Pending'}</span>}
              {ind.isExpected && <span class="checkin-time text-[10px] text-zinc-400 font-bold uppercase tracking-widest mb-2 block h-4">{ind.isCheckedIn ? formatTime(ind.checkInTime) : ''}</span>}

              {ind.isExpected ? (
                  <button class="checkin-toggle text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-sm transition-colors mt-auto w-full data-[status=true]:bg-emerald-600 data-[status=true]:text-white data-[status=false]:bg-zinc-700 data-[status=false]:text-zinc-300 hover:opacity-80" data-id={ind.id} data-target={ind.target} data-status={ind.isCheckedIn ? 'true' : 'false'}>
                    {ind.isCheckedIn ? 'Undo' : 'Check In'}
                  </button>
                ) : (
                  <div class="override-container w-full mt-auto">
                    <button class="trigger-override w-full text-[10px] text-zinc-400 font-bold uppercase tracking-widest px-3 py-2 border border-zinc-700 bg-zinc-900/50 hover:bg-zinc-800 rounded-sm transition-colors">Walk-Up Override</button>
                    <div class="override-form hidden flex flex-col gap-1 w-full">
                       <p class="text-[8px] text-pink-400 uppercase tracking-widest text-center leading-tight mb-1">Ask for Code</p>
                       <div class="flex gap-1">
                         <button class="cancel-override bg-zinc-800 text-zinc-500 hover:text-red-400 hover:bg-red-950/50 font-bold px-2 py-1 rounded-sm text-xs transition-colors" type="button">X</button>
                         <input type="text" class="override-pw flex-1 w-full bg-zinc-950 border border-zinc-700 text-zinc-100 px-2 py-1 text-xs text-center uppercase tracking-widest rounded-sm focus:outline-none focus:border-pink-400" placeholder="CODE" />
                         <button class="submit-override bg-zinc-200 text-zinc-900 font-bold px-3 py-1 rounded-sm text-xs hover:bg-white transition-colors" data-id={ind.id} data-target={ind.target}>➔</button>
                       </div>
                    </div>
                  </div>
              )}
            </div>
          )
        })}
      </div>

    </div>
  </main>
</Layout>

<script src="../../scripts/backstage.js"></script>
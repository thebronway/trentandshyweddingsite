---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import fs from 'node:fs';
import path from 'node:path';

const isProd = import.meta.env.PROD;
const baseDir = isProd ? 'dist/client/images/wedding' : 'public/images/wedding';
const galleryDir = path.join(process.cwd(), baseDir);
let photos: {thumbSrc: string, fullSrc: string, alt: string}[] = [];

try {
  if (fs.existsSync(galleryDir)) {
    const files = fs.readdirSync(galleryDir);
    photos = files
      .filter(file => /\.(jpg|jpeg|png|webp|gif)$/i.test(file))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }))
      .map(file => {
        const nameWithoutExt = path.parse(file).name;
        const formattedName = nameWithoutExt.replace(/[-_]/g, ' ');
        const altText = formattedName.charAt(0).toUpperCase() + formattedName.slice(1);
        
        return {
          thumbSrc: `/images/wedding/thumbs/${file}`,
          fullSrc: `/images/wedding/${file}`,
          alt: altText
        };
      });
  }
} catch (err) {
  console.error("Error reading wedding images directory:", err);
}
---
<Layout title="Wedding Photos">
  <Nav />
  <main class="max-w-5xl mx-auto p-6 w-full mt-8">
    <div class="flex justify-between items-end border-b border-zinc-700 pb-4 mb-8">
      <div>
        <h1 class="text-4xl md:text-5xl text-white font-display uppercase tracking-wider mb-1">The Wedding</h1>
        <p class="text-pink-400 font-bold uppercase tracking-widest text-xs">Public Gallery</p>
      </div>
      <a href="/gallery" class="text-zinc-500 hover:text-zinc-300 text-xs font-bold uppercase tracking-widest transition-colors">&larr; Back to Galleries</a>
    </div>

    <GalleryGrid images={photos} />
  </main>
</Layout>
---
interface Props {
  lookupError: string | null;
  closeDateFormatted?: string;
}
const { lookupError, closeDateFormatted } = Astro.props;
---
<div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 p-6 mb-8 border-l-4 border-l-pink-400 shadow-xl rounded-sm">
  <h2 class="text-2xl text-white font-display mb-2 uppercase tracking-widest">How to get past the bouncer:</h2>
  <p class="text-zinc-300 leading-relaxed text-sm mb-4">
    Please use the <strong>four-digit code</strong> provided on the back of your invitation to RSVP for your party.
  </p>
  <p class="text-zinc-500 text-xs italic">
    If you're having difficulties, you can also RSVP using a email address or phone number (that Trent or Shy knows) belonging to anyone listed on your invitation or reach out to Trent and Shy at shrentshredding@gmail.com for help.
  </p>
</div>
<div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 rounded-sm p-5 sm:p-8 shadow-2xl flex flex-col items-center">
  <h1 class="text-4xl md:text-6xl text-white font-display mb-2 uppercase text-center w-full">Box Office (RSVP)</h1>
  
  {closeDateFormatted && (
    <p class="text-pink-400 font-bold uppercase tracking-widest text-xs sm:text-sm mb-4 text-center">
      Open until {closeDateFormatted}
    </p>
  )}

  <p class="text-zinc-300 uppercase tracking-widest text-xs sm:text-sm mb-8 text-center">
    Enter your 4-Digit Code to RSVP
  </p>
  
  {lookupError && <p class="text-red-500 mb-6 font-bold uppercase tracking-wider bg-red-950/50 border border-red-900 px-4 py-2 w-full text-center rounded-sm">{lookupError}</p>}
  
  <form method="POST" class="flex flex-col gap-4 w-full max-w-md">
    <input 
      type="text" 
      id="ticket-search-input"
      name="searchValue" 
      required 
      placeholder="0000" 
      class="w-full bg-zinc-900 border border-zinc-700 text-zinc-100 px-4 py-6 text-3xl font-bold text-center tracking-[1em] focus:outline-none focus:border-pink-400 transition-all duration-300 uppercase rounded-sm"
    />     
    <button type="submit" class="w-full bg-zinc-200 hover:bg-white text-zinc-900 font-bold text-lg uppercase tracking-widest py-4 transition-colors rounded-sm">Find My Ticket</button>
  </form>
</div>

<script is:inline>
  (() => {
    const searchInput = document.getElementById('ticket-search-input');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        if (e.target.value.length > 4) {
          e.target.classList.remove('text-3xl', 'tracking-[1em]', 'py-6');
          e.target.classList.add('text-lg', 'tracking-widest', 'py-4');
        } else {
          e.target.classList.remove('text-lg', 'tracking-widest', 'py-4');
          e.target.classList.add('text-3xl', 'tracking-[1em]', 'py-6');
        }
      });
    }
  })();
</script>
---
interface Props {
  totalYes: number;
  totalNo: number;
  totalPending: number;
}
const { totalYes, totalNo, totalPending } = Astro.props;
const totalInvited = totalYes + totalNo + totalPending;
---
<div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 rounded-sm p-4 sm:p-6 shadow-2xl">
  <h2 class="text-xl font-display text-zinc-100 uppercase tracking-widest mb-4 border-b border-zinc-700 pb-2">Headcount</h2>
  <div class="grid grid-cols-2 gap-2 sm:gap-4 text-center">
    <div class="bg-emerald-950/30 border border-emerald-900/50 rounded-sm p-2 sm:p-4">
      <div class="text-2xl sm:text-4xl font-bold text-emerald-500">{totalYes}</div>
      <div class="text-[9px] sm:text-xs uppercase tracking-wider sm:tracking-widest text-emerald-600 mt-1">Confirmed</div>
    </div>
    <div class="bg-red-950/30 border border-red-900/50 rounded-sm p-2 sm:p-4">
      <div class="text-2xl sm:text-4xl font-bold text-red-500">{totalNo}</div>
      <div class="text-[9px] sm:text-xs uppercase tracking-wider sm:tracking-widest text-red-600 mt-1">Declined</div>
    </div>
    <div class="bg-zinc-900/60 border border-zinc-700 rounded-sm p-2 sm:p-4">
      <div class="text-2xl sm:text-4xl font-bold text-zinc-300">{totalPending}</div>
      <div class="text-[9px] sm:text-xs uppercase tracking-wider sm:tracking-widest text-zinc-400 mt-1">Pending</div>
    </div>
    <div class="bg-pink-950/30 border border-pink-900/50 rounded-sm p-2 sm:p-4">
      <div class="text-2xl sm:text-4xl font-bold text-pink-400">{totalInvited}</div>
      <div class="text-[9px] sm:text-xs uppercase tracking-wider sm:tracking-widest text-pink-500 mt-1">Total Invited</div>
    </div>
  </div>
</div>
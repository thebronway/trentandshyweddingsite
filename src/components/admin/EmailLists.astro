---
interface Props {
  emailsYes: string;
  emailsPending: string;
  emailsNo: string;
  emailsAll: string;
}
const { emailsYes, emailsPending, emailsNo, emailsAll } = Astro.props;
---
<div class="bg-zinc-800/60 backdrop-blur-md border border-zinc-700 rounded-sm p-6 shadow-2xl mb-8">
  <h2 class="text-xl font-display text-zinc-100 uppercase tracking-widest mb-4 border-b border-zinc-700 pb-2">Guest Email Broadcast Lists</h2>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div>
      <label class="block text-xs font-bold uppercase tracking-widest text-emerald-500 mb-1">Attending ({emailsYes ? emailsYes.split(',').length : 0})</label>
      <textarea readonly class="w-full bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-400 text-xs p-2 h-20 cursor-pointer focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-colors" onclick="this.select()">{emailsYes}</textarea>
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-widest text-zinc-400 mb-1">Pending ({emailsPending ? emailsPending.split(',').length : 0})</label>
      <textarea readonly class="w-full bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-400 text-xs p-2 h-20 cursor-pointer focus:outline-none focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 transition-colors" onclick="this.select()">{emailsPending}</textarea>
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-widest text-red-500 mb-1">Declined ({emailsNo ? emailsNo.split(',').length : 0})</label>
      <textarea readonly class="w-full bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-400 text-xs p-2 h-20 cursor-pointer focus:outline-none focus:border-red-400 focus:ring-1 focus:ring-red-400 transition-colors" onclick="this.select()">{emailsNo}</textarea>
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-widest text-pink-400 mb-1">Everyone ({emailsAll ? emailsAll.split(',').length : 0})</label>
      <textarea readonly class="w-full bg-zinc-900 border border-zinc-700 rounded-sm text-zinc-400 text-xs p-2 h-20 cursor-pointer focus:outline-none focus:border-pink-400 focus:ring-1 focus:ring-pink-400 transition-colors" onclick="this.select()">{emailsAll}</textarea>
    </div>
  </div>
</div>